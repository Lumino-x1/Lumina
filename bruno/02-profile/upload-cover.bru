meta {
  name: Upload cover
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/profile/cover
  body: multipart-form
  auth: inherit
}

headers {
  Origin: {{origin}}
  Accept: application/json
  Cookie: better-auth.session_token={{sessionToken}}
}

body:multipart-form {
  image: @file(../fixtures/cover.png)
}

docs {
Field name must be `image`.
}
