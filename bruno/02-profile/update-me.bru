meta {
  name: Update my profile
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/profile/me
  body: json
  auth: inherit
}

headers {
  Origin: {{origin}}
  Accept: application/json
  Cookie: better-auth.session_token={{sessionToken}}
}

body:json {
