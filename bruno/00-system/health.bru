meta {
  name: Health
  type: http
  seq: 2
  tags: [
    smoke
    workflow
    release-gate
  ]
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: inherit
}

headers {
  Origin: {{origin}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.status: eq ok
  res.body.service: eq api
}
