meta {
  name: Sign up email
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/sign-up/email
  body: json
  auth: inherit
}

headers {
  Origin: {{origin}}
  Accept: application/json
}

body:json {
    {
    "name": "Jane Doe",
    "email": "jane@college.edu",
    "password": "password123"
  }
}
