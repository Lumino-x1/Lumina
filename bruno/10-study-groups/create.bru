post {
  url: {{baseUrl}}/api/v1/study-groups
  body: json
  auth: inherit
}

headers {
  Origin: {{origin}}
  Accept: application/json
  Cookie: better-auth.session_token={{sessionToken}}
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
    {
    "name": "Operating Systems — Sem 6",
