meta {
  name: Patch group
  type: http
  seq: 42
}

patch {
  url: {{baseUrl}}/api/v1/study-groups/{{groupId}}
  body: json
  auth: inherit
}

headers {
  Origin: {{origin}}
  Accept: application/json
  Cookie: better-auth.session_token={{sessionToken}}
  If-Match: {{groupVersion}}
}

body:json {
    {
    "name": "Operating Systems — Sem 6 (updated)",
    "description": "Now includes lab walkthroughs.",
    "visibility": "PUBLIC"
  }
}
