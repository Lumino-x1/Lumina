meta {
  name: Create call
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/video/calls
  body: json
  auth: inherit
}

headers {
  Origin: {{origin}}
  Accept: application/json
  Cookie: better-auth.session_token={{sessionToken}}
}

body:json {
    {
    "type": "ONE_ON_ONE",
    "title": "DSA doubt session",
    "participantIds": [
      "{{userId}}"
    ]
  }
}
