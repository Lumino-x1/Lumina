meta {
  name: Edit comment
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/comments/{{commentId}}
  body: json
  auth: inherit
}

headers {
  Origin: {{origin}}
  Accept: application/json
  Cookie: better-auth.session_token={{sessionToken}}
}

body:json {
    {
    "content": "Updated comment text."
  }
}
