meta {
  name: Create comment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/comments/posts/{{postId}}/comments
  body: json
  auth: inherit
}

headers {
  Origin: {{origin}}
  Accept: application/json
  Cookie: better-auth.session_token={{sessionToken}}
}

body:json {
    {
    "content": "Root comment on this post.",
    "parentId": null
  }
}
