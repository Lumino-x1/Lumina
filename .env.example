# Copy this file to .env for local development. Never commit .env or any
# environment-specific secret file. Values below are intentionally empty.

# Runtime
NODE_ENV=
SERVER_PORT=
CORS_ORIGIN=
VITE_AUTH_SERVER_URL=

# Database and cache
DATABASE_URL=postgresql://lumina_user:lumina_password@localhost:5432/lumina_dev
TEST_DATABASE_URL=
REDIS_URL=
POSTGRES_USER=lumina_user
POSTGRES_PASSWORD=lumina_password
POSTGRES_DB=lumina_dev
REDIS_PASSWORD=

# Authentication and email
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
RESEND_API_KEY=
RESEND_FROM=

# Object storage
AWS_REGION=
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# External integrations
STREAM_API_KEY=
STREAM_API_SECRET=
LEETCODE_URL=
