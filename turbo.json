{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DATABASE_URL_DEV",
    "TEST_DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "SERVER_PORT",
    "CORS_ORIGIN",
    "RESEND_API_KEY",
    "RESEND_FROM",
    "VITE_AUTH_SERVER_URL",
    "VITE_API_URL",
    "VITE_PROXY_TARGET",
    "AWS_*",
    "S3_*",
    "STREAM_*",
    "REDIS_*",
    "MOCK_REDIS",
    "BREVO_*",
    "SMTP_*",
    "VERCEL",
    "VERCEL_*",
    "CRON_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "@lumina/db#build": {
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": []
    },
    "generate": {
      "cache": false
    },
    "@lumina/db#generate": {
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["generated/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "//#dev:setup": {
      "cache": false,
      "outputs": ["packages/db/generated/**"]
    },
    "dev": {
      "dependsOn": ["//#dev:setup"],
      "cache": false,
      "persistent": true,
      "outputLogs": "full"
    }
  }
}
