{
  "$schema": "./node_modules/turbo/schema.json",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "SERVER_PORT",
    "CORS_ORIGIN",
    "RESEND_API_KEY",
    "RESEND_FROM",
    "VITE_AUTH_SERVER_URL",
    "AWS_*",
    "S3_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json", "tsdown.config.*"],
      "outputs": ["dist/**", "node_modules/.cache/ts/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.*",
        "src/**",
        "test/**",
        "tests/**",
        "*.test.*",
        "*.spec.*",
        "package.json"
      ],
      "outputs": [".vitest/**", "coverage/**", "test-results/**"]
    },
    "coverage": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.*",
        "src/**",
        "test/**",
        "tests/**",
        "*.test.*",
        "*.spec.*",
        "package.json"
      ],
      "outputs": ["coverage/**"]
    },
    "lint:types": {
      "dependsOn": ["^build", "build"],
      "inputs": ["dist/**", "package.json"],
      "outputs": []
    },
    "lint:package": {
      "dependsOn": ["^build", "build"],
      "inputs": ["dist/**", "package.json"],
      "outputs": []
    },
    "generate": {
      "cache": false
    },
    "@lumina/db#generate": {
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["generated/**"]
    },
    "e2e:smoke": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "e2e:integration": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
