model AlumniProfile {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  graduationYear           Int
  departmentName           String?
  company                  String?
  jobTitle                 String?
  industry                 String?
  location                 String?
  bio                      String?
  isAvailableForMentorship Boolean  @default(true)
  directoryVisible         Boolean  @default(true)
  linkedIn                 String?
  github                   String?
  skills                   String[] @default([])
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([graduationYear])
  @@index([company])
  @@index([industry])
  @@index([isAvailableForMentorship])
}

model AlumniConnection {
  id        String                 @id @default(cuid())
  studentId String
  alumniId  String
  status    AlumniConnectionStatus @default(PENDING)
  message   String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @default(now()) @updatedAt
  student   User                   @relation("StudentConnections", fields: [studentId], references: [id], onDelete: Cascade)
  alumni    User                   @relation("AlumniConnections", fields: [alumniId], references: [id], onDelete: Cascade)

  @@unique([studentId, alumniId])
  @@index([studentId])
  @@index([alumniId])
  @@index([status])
}

model MentorshipSession {
  id              String           @id @default(cuid())
  studentId       String
  alumniId        String
  topic           String
  notes           String?
  status          MentorshipStatus @default(REQUESTED)
  scheduledAt     DateTime?
  durationMinutes Int              @default(30)
  meetingUrl      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  student         User             @relation("StudentMentorships", fields: [studentId], references: [id], onDelete: Cascade)
  alumni          User             @relation("AlumniMentorships", fields: [alumniId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([alumniId])
  @@index([status])
}

model AlumniReferral {
  id          String   @id @default(cuid())
  alumniId    String
  title       String
  company     String
  location    String?
  description String?
  link        String?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  alumni      User     @relation("AlumniReferrals", fields: [alumniId], references: [id], onDelete: Cascade)

  @@index([alumniId])
  @@index([company])
}

model AlumniEvent {
  id          String   @id @default(cuid())
  collegeId   String?
  organizerId String
  title       String
  description String?
  eventDate   DateTime
  location    String?
  virtualLink String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  organizer   User     @relation("AlumniEventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId])
  @@index([eventDate])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetId   String?
  targetType String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  admin      User     @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedById String?
  updatedAt   DateTime @default(now()) @updatedAt
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  type        String   @default("INFO")
  targetRole  String   @default("ALL")
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdBy   User     @relation("AdminAnnouncements", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([isActive])
}
model AnalyticsEvent {
  id             String   @id @default(cuid())
  name           String
  idempotencyKey String   @unique
  userId         String?
  anonymousId    String?
  collegeId      String?
  tenantId       String?
  consent        String?
  properties     Json?
  occurredAt     DateTime?
  receivedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([collegeId, receivedAt])
  @@index([userId, receivedAt])
  @@index([name, receivedAt])
  @@index([tenantId, receivedAt])
}
