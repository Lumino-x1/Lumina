generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model College {
  id          String       @id @default(cuid())
  name        String
  shortName   String?
  domain      String       @unique
  logo        String?
  website     String?
  city        String?
  state       String?
  country     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  clubs       Club[]
  communities Community[]
  departments Department[]
  users       User[]

  @@index([domain])
}

model Department {
  id        String   @id @default(cuid())
  name      String
  code      String?
  collegeId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  college   College  @relation(fields: [collegeId], references: [id])
  users     User[]

  @@unique([collegeId, name])
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  collegeId              String?
  departmentId           String?
  emailVerified          Boolean                 @default(false)
  password               String?
  phone                  String?                 @unique
  phoneVerified          Boolean                 @default(false)
  provider               Provider                @default(EMAIL)
  role                   UserRole                @default(STUDENT)
  status                 UserStatus              @default(PENDING)
  twoFactorEnabled       Boolean                 @default(false)
  username               String?                 @unique
  name                   String                  @default("")
  image                  String?
  accounts               Account[]
  clubMembers            ClubMember[]
  comments               Comment[]
  commentReactions       CommentReaction[]
  commentMentions        CommentMention[]
  commentEditHistory     CommentEditHistory[]
  commentReports         CommentReport[]
  communityMembers       CommunityMember[]
  communityPosts         CommunityPost[]
  conversations          Conversation[]
  conversationMembers    ConversationMember[]
  devices                Device[]
  events                 Event[]
  eventRegistrations     EventRegistration[]
  receivedFriendRequests FriendRequest[]         @relation("Received")
  sentFriendRequests     FriendRequest[]         @relation("Sent")
  internshipApplications InternshipApplication[]
  likes                  Like[]
  loginHistory           LoginHistory[]
  marketplaceListings    MarketplaceListing[]
  messages               Message[]
  messageReactions       MessageReaction[]
  messageReads           MessageRead[]
  notifications          Notification[]
  otps                   OTP[]
  posts                  Post[]
  profile                Profile?
  refreshTokens          RefreshToken[]
  sessions               Session[]
  studyGroups            StudyGroup[]
  studyGroupMembers      StudyGroupMember[]
  college                College?                @relation(fields: [collegeId], references: [id])
  department             Department?             @relation(fields: [departmentId], references: [id])
  verification           Verification?
  wishlists              Wishlist[]
  savedPosts             SavedPost[]
  createdVideoCalls      VideoCall[]             @relation("CreatedCalls")
  videoCallParticipants  VideoCallParticipant[]

  @@index([collegeId])
  @@index([departmentId])
}

model Profile {
  id                 String              @id @default(cuid())
  userId             String              @unique
  firstName          String
  lastName           String
  bio                String?
  about              String?
  profilePicture     String?
  profilePictureKey  String?
  coverImage         String?
  coverImageKey      String?
  gender             Gender?
  dob                DateTime?
  hometown           String?
  location           String?
  cgpa               Float?
  semester           Int?
  year               Int?
  batch              String?
  rollNumber         String?
  skills             String[]
  interests          String[]
  languages          String[]
  github             String?
  linkedin           String?
  portfolio          String?
  leetcodeUrl        String?
  leetcodeUsername   String?
  leetcodeRating     Int?
  leetcodeSolved     Int?
  leetcodeEasy       Int?
  leetcodeMedium     Int?
  leetcodeHard       Int?
  leetcodeGlobalRank Int?
  leetcodeUpdatedAt  DateTime?
  leetcodeSyncStatus LeetcodeSyncStatus?
  leetcodeSyncError  String?
  codeforces         String?
  hackerrank         String?
  profileVisibility  Visibility          @default(PUBLIC)
  hideEmail          Boolean             @default(false)
  hidePhone          Boolean             @default(false)
  hideCgpa           Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leetcodeRating])
  @@index([leetcodeSolved])
  @@index([leetcodeUsername])
  @@index([leetcodeSyncStatus])
  @@index([leetcodeUpdatedAt])
}

model Verification {
  id                   String             @id @default(cuid())
  userId               String             @unique
  studentIdImage       String?
  faceImage            String?
  collegeEmailVerified Boolean            @default(false)
  studentIdVerified    Boolean            @default(false)
  faceVerified         Boolean            @default(false)
  alumniVerified       Boolean            @default(false)
  facultyVerified      Boolean            @default(false)
  status               VerificationStatus @default(PENDING)
  verifiedBy           String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  token     String   @unique
  updatedAt DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Device {
  id         String     @id @default(cuid())
  userId     String
  name       String
  deviceType DeviceType
  lastActive DateTime
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OTP {
  id        String   @id @default(cuid())
  code      String
  email     String?
  phone     String?
  userId    String?
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  ip        String?
  location  String?
  device    String?
  success   Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model FriendRequest {
  id         String              @id @default(cuid())
  senderId   String
  receiverId String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  receiver   User                @relation("Received", fields: [receiverId], references: [id])
  sender     User                @relation("Sent", fields: [senderId], references: [id])

  @@unique([senderId, receiverId])
}

model Post {
  id           String      @id @default(cuid())
  authorId     String
  content      String?
  visibility   Visibility  @default(PUBLIC)
  anonymous    Boolean     @default(false)
  location     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  author       User        @relation(fields: [authorId], references: [id])
  media        PostMedia[]
  comments     Comment[]
  likes        Like[]
  likeCount    Int         @default(0)
  commentCount Int         @default(0)
  viewCount    Int         @default(0)
  shareCount   Int         @default(0)
  saveCount    Int         @default(0)
  savedBy      SavedPost[]

  @@index([authorId])
  @@index([createdAt])
  @@index([visibility])
}

model SavedPost {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@index([postId])
}

model PostMedia {
  id        String    @id @default(cuid())
  postId    String
  type      MediaType
  url       String
  key       String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  duration  Int?
  order     Int
  createdAt DateTime  @default(now())
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([postId, order])
}

enum MediaType {
  IMAGE
  VIDEO
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  postId    String
  userId    String
  parentId  String?
  depth     Int      @default(0)
  isDeleted Boolean  @default(false)
  isPinned  Boolean  @default(false)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  reactions   CommentReaction[]
  mentions    CommentMention[]
  editHistory CommentEditHistory[]
  reports     CommentReport[]

  @@index([postId, createdAt])
  @@index([userId])
  @@index([parentId])
  @@index([postId, isPinned])
}

model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId])
  @@index([userId])
}

model CommentMention {
  id              String   @id @default(cuid())
  commentId       String
  mentionedUserId String
  createdAt       DateTime @default(now())

  comment       Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser User    @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([commentId, mentionedUserId])
  @@index([commentId])
  @@index([mentionedUserId])
}

model CommentEditHistory {
  id              String   @id @default(cuid())
  commentId       String
  previousContent String
  editedByUserId  String
  version         Int
  createdAt       DateTime @default(now())

  comment  Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  editedBy User    @relation(fields: [editedByUserId], references: [id])

  @@index([commentId])
}

model CommentReport {
  id             String       @id @default(cuid())
  commentId      String
  reporterUserId String
  reason         String
  details        String?
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())

  comment  Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter User    @relation(fields: [reporterUserId], references: [id])

  @@unique([commentId, reporterUserId])
  @@index([commentId])
  @@index([reporterUserId])
}

enum ReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

model Like {
  id     String @id @default(cuid())
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean          @default(false)
  type      NotificationType
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])
}

enum NotificationType {
  COMMENT
  COMMENT_REPLY
  COMMENT_MENTION
  COMMENT_REACTION
  LIKE
  SHARE
  FOLLOW
  FRIEND_REQUEST
  VIDEO_CALL_INVITE
  VIDEO_CALL_START
}

model Conversation {
  id          String               @id @default(cuid())
  name        String?
  image       String?
  type        ConversationType
  description String?
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdBy   User                 @relation(fields: [createdById], references: [id])
  members     ConversationMember[]
  messages    Message[]

  @@index([createdById])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  isAdmin        Boolean      @default(false)
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  senderId       String
  replyToId      String?
  type           MessageType
  content        String?
  edited         Boolean           @default(false)
  deleted        Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  attachments    Attachment[]
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo        Message?          @relation("Reply", fields: [replyToId], references: [id])
  replies        Message[]         @relation("Reply")
  sender         User              @relation(fields: [senderId], references: [id])
  reactions      MessageReaction[]
  reads          MessageRead[]

  @@index([conversationId])
}

model Attachment {
  id        String  @id @default(cuid())
  messageId String
  url       String
  mimeType  String
  size      Int
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model MessageReaction {
  id        String  @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  message   Message @relation(fields: [messageId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
}

model Community {
  id          String            @id @default(cuid())
  name        String
  description String?
  image       String?
  banner      String?
  type        CommunityType
  collegeId   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  college     College?          @relation(fields: [collegeId], references: [id])
  members     CommunityMember[]
  posts       CommunityPost[]
}

model CommunityMember {
  id          String    @id @default(cuid())
  communityId String
  userId      String
  isModerator Boolean   @default(false)
  joinedAt    DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@unique([communityId, userId])
}

model CommunityPost {
  id          String    @id @default(cuid())
  communityId String
  authorId    String
  title       String?
  content     String?
  createdAt   DateTime  @default(now())
  author      User      @relation(fields: [authorId], references: [id])
  community   Community @relation(fields: [communityId], references: [id])
}

model Club {
  id          String       @id @default(cuid())
  name        String
  description String?
  logo        String?
  banner      String?
  collegeId   String
  createdAt   DateTime     @default(now())
  college     College      @relation(fields: [collegeId], references: [id])
  members     ClubMember[]
  events      Event[]
}

model ClubMember {
  id       String   @id @default(cuid())
  clubId   String
  userId   String
  role     ClubRole
  joinedAt DateTime @default(now())
  club     Club     @relation(fields: [clubId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([clubId, userId])
}

model Event {
  id          String              @id @default(cuid())
  title       String
  description String?
  coverImage  String?
  startTime   DateTime
  endTime     DateTime
  venue       String?
  clubId      String?
  organizerId String
  createdAt   DateTime            @default(now())
  club        Club?               @relation(fields: [clubId], references: [id])
  organizer   User                @relation(fields: [organizerId], references: [id])
  attendees   EventRegistration[]
}

model EventRegistration {
  id        String  @id @default(cuid())
  eventId   String
  userId    String
  checkedIn Boolean @default(false)
  qrCode    String?
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

model StudyGroup {
  id          String             @id @default(cuid())
  name        String
  subject     String
  semester    Int
  description String?
  ownerId     String
  createdAt   DateTime           @default(now())
  owner       User               @relation(fields: [ownerId], references: [id])
  members     StudyGroupMember[]
}

model StudyGroupMember {
  id           String     @id @default(cuid())
  studyGroupId String
  userId       String
  studyGroup   StudyGroup @relation(fields: [studyGroupId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@unique([studyGroupId, userId])
}

model MarketplaceListing {
  id          String          @id @default(cuid())
  sellerId    String
  title       String
  description String?
  price       Float
  category    ListingCategory
  status      ListingStatus   @default(ACTIVE)
  images      String[]
  createdAt   DateTime        @default(now())
  seller      User            @relation(fields: [sellerId], references: [id])
  wishlists   Wishlist[]
}

model Wishlist {
  id        String             @id @default(cuid())
  listingId String
  userId    String
  listing   MarketplaceListing @relation(fields: [listingId], references: [id])
  user      User               @relation(fields: [userId], references: [id])

  @@unique([listingId, userId])
}

model Company {
  id          String       @id @default(cuid())
  name        String
  logo        String?
  website     String?
  internships Internship[]
}

model Internship {
  id           String                  @id @default(cuid())
  companyId    String
  title        String
  description  String?
  location     String?
  stipend      Float?
  company      Company                 @relation(fields: [companyId], references: [id])
  applications InternshipApplication[]
}

model InternshipApplication {
  id           String            @id @default(cuid())
  internshipId String
  userId       String
  resumeUrl    String?
  status       ApplicationStatus @default(APPLIED)
  internship   Internship        @relation(fields: [internshipId], references: [id])
  user         User              @relation(fields: [userId], references: [id])

  @@unique([internshipId, userId])
}

model VideoCall {
  id           String                 @id @default(cuid())
  streamCallId String                 @unique
  type         VideoCallType          @default(ONE_ON_ONE)
  title        String?
  createdById  String
  status       VideoCallStatus        @default(SCHEDULED)
  scheduledAt  DateTime?
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  createdBy    User                   @relation("CreatedCalls", fields: [createdById], references: [id])
  participants VideoCallParticipant[]

  @@index([createdById])
  @@index([streamCallId])
  @@index([status])
}

model VideoCallParticipant {
  id        String                @id @default(cuid())
  callId    String
  userId    String
  role      VideoCallRole         @default(PARTICIPANT)
  joinedAt  DateTime?
  leftAt    DateTime?
  status    ParticipantCallStatus @default(INVITED)
  createdAt DateTime              @default(now())
  call      VideoCall             @relation(fields: [callId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
  @@index([callId])
  @@index([userId])
}

enum VideoCallType {
  ONE_ON_ONE
  GROUP
  MENTORSHIP
  CLUB_MEETING
  FACULTY_SESSION
}

enum VideoCallStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

enum VideoCallRole {
  HOST
  PARTICIPANT
  SPEAKER
}

enum ParticipantCallStatus {
  INVITED
  ACCEPTED
  REJECTED
  JOINED
  LEFT
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum UserRole {
  STUDENT
  FACULTY
  ALUMNI
  CLUB_ADMIN
  COMMUNITY_MODERATOR
  COLLEGE_ADMIN
  SUPER_ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum Provider {
  EMAIL
  GOOGLE
}

enum DeviceType {
  WEB
  ANDROID
  IOS
  DESKTOP
}

enum Visibility {
  PUBLIC
  COLLEGE
  FRIENDS
  PRIVATE
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  GIF
  STICKER
  SYSTEM
}

enum CommunityType {
  COLLEGE
  DEPARTMENT
  HOSTEL
  INTEREST
  STARTUP
  CODING
}

enum ClubRole {
  MEMBER
  CORE_MEMBER
  SECRETARY
  PRESIDENT
  FACULTY
}

enum EventType {
  WORKSHOP
  HACKATHON
  SEMINAR
  FEST
  WEBINAR
  OTHER
}

enum ListingStatus {
  ACTIVE
  SOLD
  HIDDEN
}

enum ListingCategory {
  BOOK
  CYCLE
  ELECTRONICS
  HOSTEL
  FURNITURE
  OTHER
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW
  REJECTED
  OFFERED
}

enum LeetcodeSyncStatus {
  PENDING
  SUCCESS
  FAILED
}
