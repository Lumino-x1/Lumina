generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model College {
  id          String   @id @default(cuid())
  name        String
  shortName   String?
  slug        String   @unique
  domain      String   @unique
  emailDomains CollegeEmailDomain[]

  logo        String?
  website     String?
  description String?

  city        String?
  state       String?
  country     String   @default("India")

  isVerified  Boolean  @default(false)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clubs       Club[]
  communities Community[]
  departments Department[]
  users       User[]

  @@index([name])
  @@index([city])
  @@index([state])
}

model CollegeEmailDomain {
  id        String   @id @default(cuid())
  domain    String   @unique
  collegeId String

  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([collegeId])
}

model Department {
  id        String   @id @default(cuid())
  name      String
  code      String?
  collegeId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  college   College  @relation(fields: [collegeId], references: [id])
  users     User[]

  @@unique([collegeId, name])
}

model User {
  id                          String                       @id @default(cuid())
  email                       String                       @unique
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  collegeId                   String?
  departmentId                String?
  emailVerified               Boolean                      @default(false)
  password                    String?
  phone                       String?                      @unique
  phoneVerified               Boolean                      @default(false)
  provider                    Provider                     @default(EMAIL)
  role                        UserRole                     @default(STUDENT)
  status                      UserStatus                   @default(PENDING)
  twoFactorEnabled            Boolean                      @default(false)
  username                    String?                      @unique
  name                        String                       @default("")
  image                       String?
  accounts                    Account[]
  clubMembers                 ClubMember[]
  comments                    Comment[]
  commentReactions            CommentReaction[]
  commentMentions             CommentMention[]
  commentEditHistory          CommentEditHistory[]
  commentReports              CommentReport[]
  communityMembers            CommunityMember[]
  communityPosts              CommunityPost[]
  conversations               Conversation[]
  conversationMembers         ConversationMember[]
  devices                     Device[]
  events                      Event[]
  eventRegistrations          EventRegistration[]
  receivedFriendRequests      FriendRequest[]              @relation("Received")
  sentFriendRequests          FriendRequest[]              @relation("Sent")
  internshipApplications      InternshipApplication[]
  likes                       Like[]
  loginHistory                LoginHistory[]
  marketplaceListings         MarketplaceListing[]
  messages                    Message[]
  messageReactions            MessageReaction[]
  messageReads                MessageRead[]
  notifications               Notification[]
  otps                        OTP[]
  posts                       Post[]
  profile                     Profile?
  refreshTokens               RefreshToken[]
  sessions                    Session[]
  studyGroups                 StudyGroup[]
  studyGroupMembers           StudyGroupMember[]
  studyGroupInvitesSent       StudyGroupInvitation[]       @relation("StudyGroupInviter")
  studyGroupInvitesReceived   StudyGroupInvitation[]       @relation("StudyGroupInvitee")
  clubInvitesSent             ClubInvitation[]             @relation("ClubInviter")
  clubInvitesReceived         ClubInvitation[]             @relation("ClubInvitee")
  studyGroupDiscussions       StudyGroupDiscussion[]
  studyGroupDiscussionReplies StudyGroupDiscussionReply[]
  studyGroupNotes             StudyGroupNote[]
  studyGroupNoteVersions      StudyGroupNoteVersion[]
  studyGroupFiles             StudyGroupFile[]
  studyGroupTimetableVersions StudyGroupTimetableVersion[]
  studyGroupAuditEvents       StudyGroupAuditEvent[]
  college                     College?                     @relation(fields: [collegeId], references: [id])
  department                  Department?                  @relation(fields: [departmentId], references: [id])
  verification                Verification?
  wishlists                   Wishlist[]
  savedPosts                  SavedPost[]
  createdVideoCalls           VideoCall[]                  @relation("CreatedCalls")
  videoCallParticipants       VideoCallParticipant[]
  alumniProfile               AlumniProfile?
  sentAlumniConnections       AlumniConnection[]           @relation("StudentConnections")
  receivedAlumniConnections   AlumniConnection[]           @relation("AlumniConnections")
  studentMentorshipSessions   MentorshipSession[]          @relation("StudentMentorships")
  alumniMentorshipSessions    MentorshipSession[]          @relation("AlumniMentorships")
  alumniReferrals             AlumniReferral[]             @relation("AlumniReferrals")
  organizedAlumniEvents       AlumniEvent[]                @relation("AlumniEventOrganizer")
  notificationPreference      NotificationPreference?
  deviceTokens                DeviceToken[]
  adminAuditLogs              AdminAuditLog[]              @relation("AdminAuditLogs")
  adminAnnouncements          Announcement[]               @relation("AdminAnnouncements")

  @@index([collegeId])
  @@index([departmentId])
}

model Profile {
  id                 String              @id @default(cuid())
  userId             String              @unique
  firstName          String
  lastName           String
  email              String
  bio                String?
  about              String?
  profilePicture     String?
  profilePictureKey  String?
  coverImage         String?
  coverImageKey      String?
  gender             Gender?
  dob                DateTime?
  hometown           String?
  location           String?
  cgpa               Float?
  semester           Int?
  year               Int?
  batch              String?
  rollNumber         String?
  skills             String[]
  interests          String[]
  languages          String[]
  github             String?
  linkedin           String?
  portfolio          String?
  leetcodeUrl        String?
  leetcodeUsername   String?
  leetcodeRating     Int?
  leetcodeSolved     Int?
  leetcodeEasy       Int?
  leetcodeMedium     Int?
  leetcodeHard       Int?
  leetcodeGlobalRank Int?
  leetcodeUpdatedAt  DateTime?
  leetcodeSyncStatus LeetcodeSyncStatus?
  leetcodeSyncError  String?
  codeforces         String?
  hackerrank         String?
  profileVisibility  Visibility          @default(PUBLIC)
  hideEmail          Boolean             @default(false)
  hidePhone          Boolean             @default(false)
  hideCgpa           Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leetcodeRating])
  @@index([leetcodeSolved])
  @@index([leetcodeUsername])
  @@index([leetcodeSyncStatus])
  @@index([leetcodeUpdatedAt])
}

model Verification {
  id                   String             @id @default(cuid())
  userId               String             @unique
  studentIdImage       String?
  faceImage            String?
  collegeEmailVerified Boolean            @default(false)
  studentIdVerified    Boolean            @default(false)
  faceVerified         Boolean            @default(false)
  alumniVerified       Boolean            @default(false)
  facultyVerified      Boolean            @default(false)
  status               VerificationStatus @default(PENDING)
  verifiedBy           String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_verifications")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  token     String   @unique
  updatedAt DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

model Device {
  id         String     @id @default(cuid())
  userId     String
  name       String
  deviceType DeviceType
  lastActive DateTime
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OTP {
  id        String   @id @default(cuid())
  code      String
  email     String?
  phone     String?
  userId    String?
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  ip        String?
  location  String?
  device    String?
  success   Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model FriendRequest {
  id         String              @id @default(cuid())
  senderId   String
  receiverId String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  receiver   User                @relation("Received", fields: [receiverId], references: [id])
  sender     User                @relation("Sent", fields: [senderId], references: [id])

  @@unique([senderId, receiverId])
}

model Post {
  id             String      @id @default(cuid())
  authorId       String
  clubId         String?

  // ==================== [NEW: EDITOR FIELDS] ====================
  title          String?     // Story / Article Title (e.g. "Campus Hackathon 2026")
  subtitle       String?     // Short description / Subheading
  coverImage     String?     // Header / Cover banner image URL
  
  // Rich Document Structure: Stores array of LuminaBlock JSON objects
  // [{ id, type, content, styles, metadata }]
  blocks         Json?       // Native PostgreSQL JSONB for fast structured storage
  
  // Plain-text excerpt for fast database search, feed snippets & SEO
  content        String?     @db.Text 
  // ==============================================================
  // 
  topics         String[]    @default([])
  category       String?     // Optional primary category (e.g. "Technology")

  visibility     Visibility  @default(PUBLIC)
  anonymous      Boolean     @default(false)
  isAnnouncement Boolean     @default(false)
  location       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?
  author         User        @relation(fields: [authorId], references: [id])
  club           Club?       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  media          PostMedia[]
  comments       Comment[]
  likes          Like[]
  likeCount      Int         @default(0)
  commentCount   Int         @default(0)
  viewCount      Int         @default(0)
  shareCount     Int         @default(0)
  saveCount      Int         @default(0)
  savedBy        SavedPost[]
  scheduledAt     DateTime? @db.Timestamptz(3)
  publishedAt     DateTime? @db.Timestamptz(3)
  scheduleVersion Int       @default(0)
  status          PostStatus @default(DRAFT)
  publishOutboxEvents PublishOutboxEvent[]

  @@index([status, scheduledAt])
  @@index([authorId, status, scheduledAt])
  @@index([authorId])
  @@index([clubId])
  @@index([createdAt])
  @@index([visibility])
}

model PublishOutboxEvent {
  id              String    @id @default(cuid())
  postId          String
  scheduleVersion Int
  scheduledAt     DateTime  @db.Timestamptz(3)
  processedAt     DateTime? @db.Timestamptz(3)
  attempts        Int       @default(0)
  lastError       String?
  createdAt       DateTime  @default(now())
  post            Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, scheduleVersion])
  @@index([processedAt, createdAt])
}

model SavedPost {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@index([postId])
}

model PostMedia {
  id        String    @id @default(cuid())
  postId    String
  type      MediaType
  url       String
  key       String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  duration  Int?
  order     Int
  createdAt DateTime  @default(now())
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([postId, order])
}

enum MediaType {
  IMAGE
  VIDEO
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  postId    String
  userId    String
  parentId  String?
  depth     Int      @default(0)
  isDeleted Boolean  @default(false)
  isPinned  Boolean  @default(false)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  reactions   CommentReaction[]
  mentions    CommentMention[]
  editHistory CommentEditHistory[]
  reports     CommentReport[]

  @@index([postId, createdAt])
  @@index([userId])
  @@index([parentId])
  @@index([postId, isPinned])
}

model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId])
  @@index([userId])
}

model CommentMention {
  id              String   @id @default(cuid())
  commentId       String
  mentionedUserId String
  createdAt       DateTime @default(now())

  comment       Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser User    @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([commentId, mentionedUserId])
  @@index([commentId])
  @@index([mentionedUserId])
}

model CommentEditHistory {
  id              String   @id @default(cuid())
  commentId       String
  previousContent String
  editedByUserId  String
  version         Int
  createdAt       DateTime @default(now())

  comment  Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  editedBy User    @relation(fields: [editedByUserId], references: [id])

  @@index([commentId])
}

model CommentReport {
  id             String       @id @default(cuid())
  commentId      String
  reporterUserId String
  reason         String
  details        String?
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())

  comment  Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter User    @relation(fields: [reporterUserId], references: [id])

  @@unique([commentId, reporterUserId])
  @@index([commentId])
  @@index([reporterUserId])
}

enum ReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

model Like {
  id     String @id @default(cuid())
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  archived  Boolean          @default(false)
  data      Json?
  type      NotificationType
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  emailEnabled Boolean  @default(true)
  pushEnabled  Boolean  @default(true)
  inAppEnabled Boolean  @default(true)
  comments     Boolean  @default(true)
  likes        Boolean  @default(true)
  mentions     Boolean  @default(true)
  events       Boolean  @default(true)
  clubs        Boolean  @default(true)
  internships  Boolean  @default(true)
  alumni       Boolean  @default(true)
  system       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   @default("WEB")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum NotificationType {
  COMMENT
  COMMENT_REPLY
  COMMENT_MENTION
  COMMENT_REACTION
  LIKE
  SHARE
  FOLLOW
  FRIEND_REQUEST
  VIDEO_CALL_INVITE
  VIDEO_CALL_START
  MESSAGE
  EVENT
  CLUB
  SYSTEM
  CLUB_INVITATION
  CLUB_JOIN
  CLUB_ROLE_CHANGE
  CLUB_ANNOUNCEMENT
  CLUB_EVENT
  INTERNSHIP
  INTERNSHIP_APPLICATION
  INTERNSHIP_STATUS_CHANGE
  ALUMNI_VERIFICATION
  ALUMNI_CONNECTION
  MENTORSHIP_REQUEST
  MENTORSHIP_STATUS
}

model Conversation {
  id          String               @id @default(cuid())
  name        String?
  image       String?
  type        ConversationType
  description String?
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdBy   User                 @relation(fields: [createdById], references: [id])
  members     ConversationMember[]
  messages    Message[]

  @@index([createdById])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  isAdmin        Boolean      @default(false)
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  senderId       String
  replyToId      String?
  type           MessageType
  content        String?
  edited         Boolean           @default(false)
  deleted        Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  attachments    Attachment[]
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo        Message?          @relation("Reply", fields: [replyToId], references: [id])
  replies        Message[]         @relation("Reply")
  sender         User              @relation(fields: [senderId], references: [id])
  reactions      MessageReaction[]
  reads          MessageRead[]

  @@index([conversationId])
}

model Attachment {
  id        String  @id @default(cuid())
  messageId String
  url       String
  mimeType  String
  size      Int
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model MessageReaction {
  id        String  @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  message   Message @relation(fields: [messageId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
}

model Community {
  id          String            @id @default(cuid())
  name        String
  description String?
  image       String?
  banner      String?
  type        CommunityType
  collegeId   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  college     College?          @relation(fields: [collegeId], references: [id])
  members     CommunityMember[]
  posts       CommunityPost[]
}

model CommunityMember {
  id          String    @id @default(cuid())
  communityId String
  userId      String
  isModerator Boolean   @default(false)
  joinedAt    DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@unique([communityId, userId])
}

model CommunityPost {
  id          String    @id @default(cuid())
  communityId String
  authorId    String
  title       String?
  content     String?
  createdAt   DateTime  @default(now())
  author      User      @relation(fields: [authorId], references: [id])
  community   Community @relation(fields: [communityId], references: [id])
}

model Club {
  id          String           @id @default(cuid())
  name        String
  description String?
  category    String?
  status      String           @default("ACTIVE")
  logo        String?
  banner      String?
  collegeId   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  college     College          @relation(fields: [collegeId], references: [id])
  members     ClubMember[]
  events      Event[]
  posts       Post[]
  invitations ClubInvitation[]
}

model ClubMember {
  id       String   @id @default(cuid())
  clubId   String
  userId   String
  role     ClubRole
  joinedAt DateTime @default(now())
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
}

model ClubInvitation {
  id        String               @id @default(cuid())
  clubId    String
  inviterId String
  inviteeId String
  role      ClubRole             @default(MEMBER)
  message   String?
  status    ClubInvitationStatus @default(PENDING)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  club      Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  inviter   User                 @relation("ClubInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee   User                 @relation("ClubInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([clubId, inviteeId])
}

model Event {
  id          String              @id @default(cuid())
  title       String
  description String?
  coverImage  String?
  startTime   DateTime
  endTime     DateTime
  venue       String?
  clubId      String?
  organizerId String
  createdAt   DateTime            @default(now())
  club        Club?               @relation(fields: [clubId], references: [id])
  organizer   User                @relation(fields: [organizerId], references: [id])
  attendees   EventRegistration[]
}

model EventRegistration {
  id        String  @id @default(cuid())
  eventId   String
  userId    String
  checkedIn Boolean @default(false)
  qrCode    String?
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

model StudyGroup {
  id            String                 @id @default(cuid())
  name          String
  type          StudyGroupType
  visibility    StudyGroupVisibility   @default(PRIVATE)
  subject       String
  semester      Int
  description   String?
  ownerId       String
  version       Int                    @default(1)
  chatChannelId String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  owner         User                   @relation(fields: [ownerId], references: [id])
  members       StudyGroupMember[]
  invitations   StudyGroupInvitation[]
  discussions   StudyGroupDiscussion[]
  notes         StudyGroupNote[]
  files         StudyGroupFile[]
  timetable     StudyGroupTimetable?
  auditEvents   StudyGroupAuditEvent[]

  @@index([ownerId])
  @@index([name])
  @@index([subject])
}

model StudyGroupMember {
  id           String               @id @default(cuid())
  studyGroupId String
  userId       String
  role         StudyGroupMemberRole @default(MEMBER)
  joinedAt     DateTime             @default(now())
  studyGroup   StudyGroup           @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id])

  @@unique([studyGroupId, userId])
  @@index([userId])
}

model StudyGroupInvitation {
  id           String                     @id @default(cuid())
  studyGroupId String
  inviterId    String
  inviteeId    String
  message      String?
  status       StudyGroupInvitationStatus @default(PENDING)
  createdAt    DateTime                   @default(now())
  studyGroup   StudyGroup                 @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)
  inviter      User                       @relation("StudyGroupInviter", fields: [inviterId], references: [id])
  invitee      User                       @relation("StudyGroupInvitee", fields: [inviteeId], references: [id])

  @@unique([studyGroupId, inviteeId])
  @@index([inviteeId, status])
}

model StudyGroupDiscussion {
  id           String                      @id @default(cuid())
  studyGroupId String
  authorId     String
  title        String
  body         String
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  studyGroup   StudyGroup                  @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)
  author       User                        @relation(fields: [authorId], references: [id])
  replies      StudyGroupDiscussionReply[]

  @@index([studyGroupId, createdAt])
}

model StudyGroupDiscussionReply {
  id           String               @id @default(cuid())
  discussionId String
  authorId     String
  body         String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  discussion   StudyGroupDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author       User                 @relation(fields: [authorId], references: [id])

  @@index([discussionId, createdAt])
}

model StudyGroupNote {
  id           String                  @id @default(cuid())
  studyGroupId String
  authorId     String
  title        String
  body         String
  version      Int                     @default(1)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  studyGroup   StudyGroup              @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)
  author       User                    @relation(fields: [authorId], references: [id])
  versions     StudyGroupNoteVersion[]

  @@index([studyGroupId, updatedAt])
}

model StudyGroupNoteVersion {
  id        String         @id @default(cuid())
  noteId    String
  editorId  String
  version   Int
  title     String
  body      String
  createdAt DateTime       @default(now())
  note      StudyGroupNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  editor    User           @relation(fields: [editorId], references: [id])

  @@unique([noteId, version])
  @@index([noteId])
}

model StudyGroupFile {
  id           String     @id @default(cuid())
  studyGroupId String
  uploaderId   String
  key          String     @unique
  url          String?
  fileName     String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime   @default(now())
  studyGroup   StudyGroup @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)
  uploader     User       @relation(fields: [uploaderId], references: [id])

  @@index([studyGroupId, createdAt])
}

model StudyGroupTimetable {
  id           String                       @id @default(cuid())
  studyGroupId String                       @unique
  content      Json
  version      Int                          @default(1)
  updatedAt    DateTime                     @updatedAt
  studyGroup   StudyGroup                   @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)
  versions     StudyGroupTimetableVersion[]
}

model StudyGroupTimetableVersion {
  id          String              @id @default(cuid())
  timetableId String
  editorId    String
  version     Int
  content     Json
  createdAt   DateTime            @default(now())
  timetable   StudyGroupTimetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  editor      User                @relation(fields: [editorId], references: [id])

  @@unique([timetableId, version])
}

model StudyGroupAuditEvent {
  id           String     @id @default(cuid())
  studyGroupId String
  actorId      String
  action       String
  metadata     Json?
  createdAt    DateTime   @default(now())
  studyGroup   StudyGroup @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)
  actor        User       @relation(fields: [actorId], references: [id])

  @@index([studyGroupId, createdAt])
}

model MarketplaceListing {
  id          String          @id @default(cuid())
  sellerId    String
  title       String
  description String?
  price       Float
  category    ListingCategory
  status      ListingStatus   @default(ACTIVE)
  images      String[]
  createdAt   DateTime        @default(now())
  seller      User            @relation(fields: [sellerId], references: [id])
  wishlists   Wishlist[]
}

model Wishlist {
  id        String             @id @default(cuid())
  listingId String
  userId    String
  listing   MarketplaceListing @relation(fields: [listingId], references: [id])
  user      User               @relation(fields: [userId], references: [id])

  @@unique([listingId, userId])
}

model Company {
  id          String       @id @default(cuid())
  name        String
  logo        String?
  website     String?
  description String?
  industry    String?
  location    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  internships Internship[]
}

model Internship {
  id           String                  @id @default(cuid())
  companyId    String
  title        String
  description  String?
  location     String?
  stipend      Float?
  type         String                  @default("FULL_TIME")
  mode         String                  @default("HYBRID")
  status       String                  @default("PUBLISHED")
  requirements String[]                @default([])
  skills       String[]                @default([])
  deadline     DateTime?
  contactEmail String?
  collegeId    String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @default(now()) @updatedAt
  company      Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications InternshipApplication[]

  @@index([companyId])
  @@index([status])
  @@index([title])
}

model InternshipApplication {
  id           String            @id @default(cuid())
  internshipId String
  userId       String
  resumeUrl    String?
  coverLetter  String?
  status       ApplicationStatus @default(APPLIED)
  notes        String?
  reviewedAt   DateTime?
  reviewedById String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt
  internship   Internship        @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([internshipId, userId])
  @@index([userId])
  @@index([internshipId])
  @@index([status])
}

model VideoCall {
  id           String                 @id @default(cuid())
  streamCallId String                 @unique
  type         VideoCallType          @default(ONE_ON_ONE)
  title        String?
  createdById  String
  status       VideoCallStatus        @default(SCHEDULED)
  scheduledAt  DateTime?
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  createdBy    User                   @relation("CreatedCalls", fields: [createdById], references: [id])
  participants VideoCallParticipant[]

  @@index([createdById])
  @@index([streamCallId])
  @@index([status])
}

model VideoCallParticipant {
  id        String                @id @default(cuid())
  callId    String
  userId    String
  role      VideoCallRole         @default(PARTICIPANT)
  joinedAt  DateTime?
  leftAt    DateTime?
  status    ParticipantCallStatus @default(INVITED)
  createdAt DateTime              @default(now())
  call      VideoCall             @relation(fields: [callId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
  @@index([callId])
  @@index([userId])
}

