{
  "name": "@lumina/test-utils",
  "version": "0.0.1",
  "private": true,
  "description": "Shared test helpers for Lumina packages and e2e suites.",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"process.exit(0)\"",
    "dev": "node -e \"process.exit(0)\"",
    "clean": "rm -rf dist",
    "lint:package": "node -e \"process.exit(0)\"",
    "lint:types": "node -e \"process.exit(0)\"",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest --passWithNoTests",
    "coverage": "vitest run --coverage --passWithNoTests"
  },
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "dev-source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@lumina/auth": "workspace:*",
    "@lumina/core": "workspace:*",
    "@lumina/db": "workspace:*",
    "@lumina/demo-api": "workspace:*",
    "better-auth": "^1.6.25",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "typescript": "catalog:",
    "vitest": "catalog:vitest"
  }
}
